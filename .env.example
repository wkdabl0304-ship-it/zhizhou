# 本地配置模板：复制到仓库根目录 .env；后端读取时由系统环境变量覆盖同名值。
# 这里只保留安全示例，实际模型密钥填写到未纳入版本管理的 .env 中。
DEEPSEEK_API_KEY=
# Compose 初始化数据库所用的凭据，也是后端连接 PostgreSQL 时使用的参数。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zhizhou
# 这是宿主机数据库端口；修改后需要同步调整 Compose 中固定的端口映射。
POSTGRES_PORT=5432
# PostgreSQL 主机默认本机，容器部署时可改为对应服务名。
POSTGRES_HOST=127.0.0.1

# JWT 签名密钥，无默认值；使用密码学随机源生成至少 32 字节的独立密钥。
JWT_SECRET=
# 访问令牌有效期，单位秒；本期过期后重新登录，不支持刷新或服务端撤销。
JWT_TTL_SECONDS=7200

# 日志配置：系统环境变量优先于此文件
LOG_LEVEL=INFO
LOG_THIRD_PARTY_LEVEL=WARNING
LOG_ACCESS_ENABLED=true
