# 本地配置模板：复制到仓库根目录 .env；后端读取时由系统环境变量覆盖同名值。
# 模型 API Key 通过登录后的接口配置；这里仅保存加密凭据所需的部署主密钥。
# 在 backend/ 执行 uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成。
# 主密钥独立于 JWT，必须稳定保存；更换主密钥不会自动重新加密数据库中的已有凭据。
MODEL_CONFIG_ENCRYPTION_KEY=
# Compose 初始化数据库所用的凭据，也是后端连接 PostgreSQL 时使用的参数。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zhizhou
# 这是宿主机数据库端口；修改后需要同步调整 Compose 中固定的端口映射。
POSTGRES_PORT=5432
# PostgreSQL 主机默认本机，容器部署时可改为对应服务名。
POSTGRES_HOST=127.0.0.1

# JWT 签名密钥，无默认值；使用密码学随机源生成至少 32 字节的独立密钥。
JWT_SECRET=
# 访问令牌有效期，单位秒；过期后重新登录，不支持刷新，停用或改密会撤销旧凭据。
JWT_TTL_SECONDS=7200

# 私有原文件目录；相对路径基于 backend/，不随命令启动目录变化。
# 多进程须指向同一目录；上传大小限制通过文件 API 配置，不在环境变量维护。
FILE_STORAGE_ROOT=.data/files

# 日志配置：系统环境变量优先于此文件
LOG_LEVEL=INFO
LOG_THIRD_PARTY_LEVEL=WARNING
LOG_ACCESS_ENABLED=true
